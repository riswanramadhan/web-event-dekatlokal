{
  "name": "dekatlokal-event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "build:open-next": "npm run build && node scripts/patch-opennext-runtime.mjs && opennextjs-cloudflare build --skipNextBuild && wrangler deploy --dry-run --outdir .open-next/.wrangler-bundle && node scripts/finalize-opennext-runtime.mjs",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^12.42.2",
    "iconoir-react": "^7.11.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pageflip": "^2.0.3",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "pdfkit": "^0.19.1",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.23",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
