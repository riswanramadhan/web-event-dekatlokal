# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional trusted proxy header for distributed rate limiting. Set this to
# cf-connecting-ip only when Cloudflare directly fronts the app. Vercel is
# detected automatically, so leave this blank there and in local development.
TRUSTED_IP_HEADER=

# Admin panel uses Supabase Auth. Accounts are managed from /admin/users,
# so there is no admin password to configure here. The publishable key above
# is required for the login flow.

# Event
REGISTRATION_EVENT_SLUG=ai-co-creation-lab-makassar

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
